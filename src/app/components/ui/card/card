"use client"

import type { ReactNode } from "react"
import { ArrowUpRight, ArrowDownRight } from "lucide-react"
import { Area, AreaChart, Bar, BarChart, ResponsiveContainer } from "recharts"
import { cn } from "@/lib/utils"

type TrendDirection = "up" | "down"

export interface StatCardProps {
  /** Etiqueta superior de la card (ej. "Total Users") */
  title: string
  /** Valor principal ya formateado (ej. "78,250" o "$35,078") */
  value: string
  /** Porcentaje de variación (ej. "70.5%") */
  percentage: string
  /** Dirección de la tendencia: controla icono y color del badge */
  trend: TrendDirection
  /** Serie de datos para la mini-gráfica */
  data: number[]
  /** Tipo de gráfica a renderizar */
  chartType: "bar" | "area"
  /** Color principal de la gráfica (hex/oklch/css var) */
  color: string
  className?: string
}

function TrendBadge({ trend, percentage }: { trend: TrendDirection; percentage: string }) {
  const isUp = trend === "up"
  const Icon = isUp ? ArrowUpRight : ArrowDownRight

  return (
    <span
      className={cn(
        "inline-flex items-center gap-1 rounded-md border px-1.5 py-0.5 text-xs font-medium",
        isUp
          ? "border-sky-200 bg-sky-50 text-sky-600"
          : "border-amber-200 bg-amber-50 text-amber-600",
      )}
    >
      <Icon className="size-3" aria-hidden="true" />
      {percentage}
    </span>
  )
}

function MiniChart({
  data,
  chartType,
  color,
  gradientId,
}: {
  data: number[]
  chartType: StatCardProps["chartType"]
  color: string
  gradientId: string
}) {
  const chartData = data.map((v, i) => ({ i, v }))

  return (
    <ResponsiveContainer width="100%" height="100%">
      {chartType === "bar" ? (
        <BarChart data={chartData} margin={{ top: 4, right: 0, bottom: 0, left: 0 }}>
          <Bar dataKey="v" fill={color} radius={[2, 2, 0, 0]} />
        </BarChart>
      ) : (
        <AreaChart data={chartData} margin={{ top: 4, right: 0, bottom: 0, left: 0 }}>
          <defs>
            <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stopColor={color} stopOpacity={0.4} />
              <stop offset="100%" stopColor={color} stopOpacity={0} />
            </linearGradient>
          </defs>
          <Area
            type="monotone"
            dataKey="v"
            stroke={color}
            strokeWidth={2}
            fill={`url(#${gradientId})`}
          />
        </AreaChart>
      )}
    </ResponsiveContainer>
  )
}

export function StatCard({
  title,
  value,
  percentage,
  trend,
  data,
  chartType,
  color,
  className,
}: StatCardProps) {
  const gradientId = `stat-gradient-${title.replace(/\s+/g, "-").toLowerCase()}`

  return (
    <div
      className={cn(
        "flex flex-col overflow-hidden rounded-xl border border-border bg-card",
        className,
      )}
    >
      <div className="flex flex-col gap-3 p-5">
        <p className="text-sm text-muted-foreground">{title}</p>
        <div className="flex items-center gap-2">
          <span className="text-2xl font-bold tracking-tight text-foreground">{value}</span>
          <TrendBadge trend={trend} percentage={percentage} />
        </div>
      </div>
      <div className="h-20 w-full">
        <MiniChart data={data} chartType={chartType} color={color} gradientId={gradientId} />
      </div>
    </div>
  )
}
