{
  "name": "mantis-free-angular-admin-template",
  "version": "6.0.0",
  "author": "CodedThemes",
  "license": "MIT",
  "scripts": {
    "ng": "bun node_modules/@angular/cli/bin/ng.js",
    "start": "bun node_modules/@angular/cli/bin/ng.js serve",
    "prebuild": "bun scripts/configure-environment.mjs",
    "build": "bun node_modules/@angular/cli/bin/ng.js build",
    "build-prod": "bun node_modules/@angular/cli/bin/ng.js build --configuration production --base-href /angular/free/",
    "watch": "bun node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "lint": "bun node_modules/@angular/cli/bin/ng.js lint",
    "lint:fix": "bun node_modules/@angular/cli/bin/ng.js lint --fix",
    "prettier": "bunx prettier --write ./src"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "22.0.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/router": "22.0.0",
    "@lucide/angular": "^1.28.0",
    "apexcharts": "5.11.0",
    "ng-apexcharts": "2.4.0",
    "rxjs": "~7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "ajv": "8.20.0",
    "angular-eslint": "22.6.0",
    "baseline-browser-mapping": "2.10.29",
    "eslint": "10.3.0",
    "postcss": "^8.5.25",
    "prettier": "3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
